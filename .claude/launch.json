{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agentcad-viewer",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "agentcad.cli",
        "--root",
        "playground",
        "viewer",
        "--port",
        "8781"
      ],
      "port": 8781,
      "autoPort": false
    },
    {
      "name": "agentcad-setup-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "agentcad.cli",
        "setup",
        "--gui",
        "--dry-run",
        "--no-browser",
        "--port",
        "8790"
      ],
      "port": 8790
    },
    {
      "name": "viewer-prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web/viewer",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
