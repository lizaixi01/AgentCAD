\": \"[x, y, z] sketch x axis (default: global X projected)\"}, \"body\": {\"type\": \"string\", \"description\": \"see conventions.body\"}, \"tag\": {\"type\": \"string\", \"description\": \"see conventions.tag\"}}, \"required\": [\"shapes\"], \"additionalProperties\": false}, \"kind\": \"part\"}, {\"op\": \"pad\", \"category\": \"part_feature\", \"description\": \"Extrude a sketch's closed profiles into solid, along the sketch normal\", \"params\": {\"type\": \"object\", \"properties\": {\"sketch\": {\"type\": \"string\", \"description\": \"Sketch feature reference (see conventions.feature)\"}, \"length\": {\"type\": [\"number\", \"string\"], \"description\": \"Extrusion length (dim)\"}, \"symmetric\": {\"type\": \"boolean\", \"description\": \"Extrude half to each side of the sketch\", \"default\": false}, \"reversed\": {\"type\": \"boolean\", \"description\": \"Extrude against the normal\", \"default\": false}, \"body\": {\"type\": \"string\", \"description\": \"see conventions.body\"}, \"tag\": {\"type\": \"string\", \"description\": \"see conventions.tag\"}}, \"required\": [\"sketch\", \"length\"], \"additionalProperties\": false}, \"kind\": \"part\"}, {\"op\": \"pocket\", \"category\": \"part_feature\", \"description\": \"Cut a sketch's closed profiles out of the solid, against the sketch normal\", \"params\": {\"type\": \"object\", \"properties\": {\"sketch\": {\"type\": \"string\", \"description\": \"Sketch feature reference (see conventions.feature)\"}, \"depth\": {\"type\": [\"number\", \"string\"], \"description\": \"Cut depth (or through_all) (dim)\"}, \"through_all\": {\"type\": \"boolean\", \"description\": \"Cut through the whole solid\", \"default\": false}, \"symmetric\": {\"type\": \"boolean\", \"description\": \"Cut half to each side\", \"default\": false}, \"reversed\": {\"type\": \"boolean\", \"description\": \"Cut along the normal instead\", \"default\": false}, \"body\": {\"type\": \"string\", \"description\": \"see conventions.body\"}, \"tag\": {\"type\": \"string\", \"description\": \"see conventions.tag\"}}, \"required\": [\"sketch\"], \"additionalProperties\": false}, \"kind\": \"part\"}, {\"op\": \"primitive\", \"category\": \"part_feature\", \"description\": \"Add (or with subtractive=true cut) a box, cylinder, cone, sphere, torus, prism or wedge\", \"params\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\", \"enum\": [\"box\", \"cylinder\", \"cone\", \"sphere\", \"torus\", \"prism\", \"wedge\"], \"description\": \"Primitive\"}, \"dims\": {\"type\": \"object\", \"description\": \"box {length, width, height}; cylinder {radius, height, angle}; cone {radius1, radius2, height}; sphere {radius}; torus {radius1, radius2}; prism {sides, circumradius, height}; wedge {xmin, xmax, ymin, ymax, zmin, zmax, x2min, x2max, z2min, z2max}\"}, \"position\": {\"type\": \"array\", \"description\": \"[x, y, z] of the primitive's origin (box: a corner; cylinder: base centre)\"}, \"direction\": {\"type\": \"array\", \"description\": \"[x, y, z] the primitive's local Z points along (default +Z)\"}, \"subtractive\": {\"type\": \"boolean\", \"description\": \"Cut instead of add\", \"default\": false}, \"body\": {\"type\": \"string\", \"description\": \"see conventions.body\"}, \"tag\": {\"type\": \"string\", \"description\": \"see conventions.tag\"}}, \"required\": [\"kind\"], \"additionalProperties\": false}, \"kind\": \"part\"}], \"count\": 4, \"detail\": true, \"constraint_types\": {\"check\": [\"angle\", \"coincident\", \"concentric\", \"diameter\", \"distance\", \"equal\", \"fixed\", \"horizontal\", \"length\", \"parallel\", \"perpendicular\", \"radius\", \"symmetric\", \"tangent\", \"vertical\"], \"enforce\": [\"coincident\", \"concentric\", \"diameter\", \"distance\", \"equal\", \"fixed\", \"horizontal\", \"length\", \"parallel\", \"perpendicular\", \"radius\", \"vertical\"]}, \"conventions\": {\"dim\": \"a length or angle: a number (mm or degrees), a string with a unit ('0.5in', '30deg'), or an expression such as '=Params.width * 2'\", \"edges\": \"edge selector, re-resolved after every edit: 'all', 'Edge3', or an object with any of type (line|circle|...), direction (x|y|z|-z|[x,y,z], lines parallel to it), axis (circles around it), radius|diameter, length, x|y|z (all points on that coordinate), box [[x0,y0,z0],[x1,y1,z1]], face (a face selector: edges of those faces), near [x,y,z] + count (nearest ones); a list unites selectors\", \"faces\": \"face selector, re-resolved after every edit: 'top'|'bottom'|'front'|'back'|'left'|'right' (outermost planar face), 'Face2', or an object with any of type (plane|cylinder|...), normal (+z|-x|[x,y,z]), extreme (max|min along the normal), axis, radius|diameter, inner (holes), x|y|z, box, near + count\", \"feature\": \"feature reference: 'tag:<name>', '$<op index in this batch>' or an object name such as 'Pad001'\", \"body\": \"Body to add to (default: the part's only Body, created on first use) (every op that adds a feature)\", \"tag\": \"Name for later reference as 'tag:<name>' (every op that adds a feature)\"}, \"metrics\": {\"duration_ms\": 0.17, \"input_bytes\": 65, \"output_bytes\": 6290}}"}], "structured_content": null}, "error": null, "status": "completed"}}
